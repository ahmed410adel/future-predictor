    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@cvfp/data-models": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "three": "0.185.1",
    "@types/three": "^0.185.0"
  }
}
