# Copy to .env for local work. On EC2 these come from the launch template / SSM, never from git.
PORT=3000

# PLACEHOLDER: the internal ALB DNS name in AWS. Locally, point at the backend (npm run start in backend).
BACKEND_URL=http://127.0.0.1:8080

# PLACEHOLDER: origin the browser uploads CVs to (the S3 bucket). Leave empty in mock mode.
# Example: https://my-cv-bucket.s3.us-east-1.amazonaws.com
S3_UPLOAD_ORIGIN=

# Max prediction requests per client IP per minute (protects your Bedrock bill)
RATE_LIMIT_PER_MINUTE=6

# Set to true when running behind the public ALB so the real client IP is read from X-Forwarded-For
TRUST_PROXY=false
