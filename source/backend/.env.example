# Copy to .env for local work. On EC2 these come from the launch template / SSM, never from git.
PORT=8080

# true  = in-memory S3/DynamoDB and a fake model, no AWS needed (local development)
# false = real AWS
USE_MOCKS=true

AWS_REGION=us-east-1

# ---- PLACEHOLDERS: fill these in once Terraform has created the resources ----
CV_BUCKET=REPLACE_ME_cv-bucket-name
RESULTS_TABLE=REPLACE_ME_results-table-name
# Amazon Nova model or inference profile id available in your region
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Long random string (openssl rand -hex 32). Signs owner tokens.
OWNER_TOKEN_SECRET=REPLACE_ME_long_random_string

# Optional endpoint overrides, e.g. VPC interface endpoints. Leave empty for the AWS defaults.
S3_ENDPOINT=
DYNAMODB_ENDPOINT=
BEDROCK_ENDPOINT=

# Optional: delete results after N days (needs a TTL attribute named expiresAt on the table)
RESULT_TTL_DAYS=
